# Copia este archivo como .env y llena los valores. El .env NUNCA se sube a git.
# Sin SMTP en desarrollo, los correos van a un buzón de prueba de Ethereal (el link sale en la consola).
# Y si Ethereal no contesta en 5 s, el correo se imprime directo en la consola del server.
# En producción (NODE_ENV=production) el SMTP es obligatorio.
PUERTO=3001
ORIGEN_PERMITIDO=http://localhost:5173

# Cuántos proxies hay delante del server (en Render/Railway normalmente es 1). En local déjalo en 0
SALTOS_PROXY=0

# SMTP (con Gmail: smtp.gmail.com, puerto 465 y una "contraseña de aplicación")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USUARIO=tu-correo@gmail.com
SMTP_CLAVE=tu-contraseña-de-aplicacion

# A dónde llegan los mensajes (si no se pone, llegan al SMTP_USUARIO)
CORREO_DESTINO=tu-correo@gmail.com

# Dónde se guardan los mensajes de contacto (por defecto datos/contactos.json dentro de server/).
# En Render/Railway apúntalo a un disco persistente, o se borran en cada deploy
# RUTA_CONTACTOS=datos/contactos.json
